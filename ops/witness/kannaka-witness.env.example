# /etc/kannaka-witness.env — witness node environment (chmod 600).
# Copy to /etc/kannaka-witness.env on the host and fill in real values.
# DO NOT commit the filled-in file — it holds NATS credentials.

# Swarm identity for this witness node.
KANNAKA_AGENT_ID=kannaka-witness-01

# HRM data dir (default ~/.kannaka if unset).
KANNAKA_DATA_DIR=/home/opc/.kannaka

# NATS connection for swarm join/sync (Oracle NATS has authz — anon can't
# publish QUEEN.* ). Get creds from /home/opc/.kannaka-nats.env on the box.
KANNAKA_NATS_URL=nats://swarm.ninja-portal.com:4222
NATS_USER=
NATS_PASSWORD=

# Optional loop overrides (defaults shown):
# WITNESS_STREAM_URL=https://radio.ninja-portal.com/stream
# WITNESS_TICK_SLEEP=300
